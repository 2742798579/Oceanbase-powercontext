# 复制为 .env 后按需修改；不要提交真实凭据
# ---------- seekdb ----------
# 嵌入式 seekdb 的数据目录。留空 = 自动选择：
#   仓库路径是纯 ASCII 时用 data/seekdb，否则退到 %LOCALAPPDATA%/KnowReturn/seekdb
# Windows 上 seekdb 打不开含中文的目录，项目放在中文路径下时请显式指定一个英文路径
# SEEKDB_PATH=C:/seekdb-data/knowreturn
SEEKDB_DATABASE=recall

# ---------- 向量模型 ----------
# auto = 有模型文件就用 onnx，否则用 hash；onnx = 强制语义模型；hash = 强制哈希
EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL_DIR=data/models/bge-small-zh-v1.5

# ---------- PowerContext（记忆层） ----------
POWERCONTEXT_URL=http://127.0.0.1:8000
# 留空时应用会自动创建 Scope 并把 scope_id 缓存到 data/powercontext_scope.txt
POWERCONTEXT_SCOPE=
# 服务端开了鉴权才需要
POWERCONTEXT_TOKEN=

# ---------- 检索参数 ----------
RECALL_VECTOR_CANDIDATES=20
RECALL_FULLTEXT_CANDIDATES=20
RECALL_RRF_K=60
RECALL_COURSE_BOOST=0.012
RECALL_WEAK_TOPIC_BOOST=0.008
RECALL_DEFAULT_CARD_LIMIT=10
